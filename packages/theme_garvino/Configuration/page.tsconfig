# disable everything globally for the new fields, so they are only visible
# if the site config enables the fields
TCEFORM.pages {
  tx_themegarvino_logo.disabled = 1
}

# Hide custom content types globally, they are only enabled via the set's page.tsconfig
TCEFORM.tt_content {
  CType.removeItems := addToList(garvino_hero)
  CType.removeItems := addToList(garvino_hero_small)
  CType.removeItems := addToList(garvino_hero_text_only)
  CType.removeItems := addToList(garvino_textteaser)
  CType.removeItems := addToList(garvino_testimonial)
  CType.removeItems := addToList(garvino_author)
  CType.removeItems := addToList(garvino_textmedia_teaser)
  CType.removeItems := addToList(garvino_textmedia_teaser_grid)
  CType.removeItems := addToList(garvino_linklist)
  CType.removeItems := addToList(garvino_sociallinks)

  tx_themegarvino_header_style.disabled = 1
  tx_themegarvino_link.disabled = 1
  tx_themegarvino_link_label.disabled = 1
  tx_themegarvino_link_config.disabled = 1
  tx_themegarvino_link_icon.disabled = 1
}
