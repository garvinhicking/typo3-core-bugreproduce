{
  "name": "garvinhicking/gh-sitepackage",
  "type": "typo3-cms-extension",
  "description": "Sitepackage",
  "authors": [
    {
      "name": "Garvin Hicking",
      "homepage": "https://garv.in",
      "role": "Developer"
    }
  ],
  "license": "MIT",
  "require": {
    "php": ">= 8.1.0, <= 8.5.99",
    "typo3/cms-core": "^12.4 || ^13.0 || 14.1.*@dev || 14.2.*@dev || 14.3.*@dev || 15.*.*@dev"
  },
  "autoload": {
    "psr-4": {
      "GarvinHicking\\Site\\": "Classes"
    }
  },
  "replace": {
    "garvinhicking/gh_sitepackage": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "gh_sitepackage"
    }
  }
}  
